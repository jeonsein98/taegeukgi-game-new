# ==========================================
# 환경 변수 설정 가이드 (.env.local.example)
# ==========================================

# 1. Google Gemini API 키 (서버 전용, 절대 NEXT_PUBLIC_ 접두사 사용 금지)
# AI Studio 또는 Google AI Studio에서 발급받은 키를 입력합니다.
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. 구글 스프레드시트 Apps Script Web App 배포 URL
# Google Apps Script에서 '웹 앱으로 배포' 후 생성된 URL을 입력합니다.
# (선택 사항이며, 앱 내 화면에서도 직접 테스트 URL 입력 가능)
NEXT_PUBLIC_GAS_URL=""
